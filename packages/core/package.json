{
  "name": "@nah/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    "./*": "./src/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --emitDeclarationOnly",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "TZ=America/New_York node --import tsx --test src/*.test.ts && TZ=Asia/Tokyo node --import tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "tsx": "^4.20.5"
  }
}
